# Sao chép file này thành ".env" khi chạy trên máy.
# Trên Hostinger, nhập các biến này trong hPanel → Node.js → Environment variables.

PORT=3000

# Địa chỉ website sau khi có tên miền (dùng cho sitemap, SEO)
SITE_URL=https://matnang.vn

# --- Gửi email form báo giá (Gmail) ---
# SMTP_PASS là "Mật khẩu ứng dụng" (App Password) 16 ký tự của Gmail,
# KHÔNG phải mật khẩu đăng nhập Gmail. Xem README mục 4.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=matnangfoods@gmail.com
SMTP_PASS=
MAIL_TO=matnangfoods@gmail.com
